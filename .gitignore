# Paquet installé en mode éditable, tests
*.egg-info/
build/
.pytest_cache/

# Banque du MJ (fiches, notes, portraits) : ne jamais la versionner
/pnj/

# Couverture, builds et caches d'outils
.coverage
htmlcov/
dist/
.ruff_cache/
.mypy_cache/

